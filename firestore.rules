rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function approved() { return signedIn() && profile().data.status == 'aprovado'; }
    function admin() { return approved() && profile().data.nivel == 'admin'; }
    function sector() { return profile().data.setor; }
    function sameSector(data) { return data.setor == sector(); }

    match /usuarios/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.status == 'pendente' && request.resource.data.nivel == 'leitor';
      allow read: if signedIn() && (request.auth.uid == userId || (admin() && sameSector(resource.data)));
      allow update: if signedIn() && ((request.auth.uid == userId && request.resource.data.setor == resource.data.setor && request.resource.data.nivel == resource.data.nivel && request.resource.data.status == resource.data.status) || (admin() && request.auth.uid != userId && sameSector(resource.data) && sameSector(request.resource.data)));
      allow delete: if admin() && sameSector(resource.data);
    }

    match /notificacoes/{documentId} {
      allow read: if approved() && sameSector(resource.data);
      // A criação inicial passa por função de backend para reservar numeração atômica.
      allow create: if false;
      allow update: if approved() && sameSector(resource.data) && request.resource.data.setor == sector() && profile().data.nivel != 'leitor'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['setor', 'numNotif', 'statusProcesso', 'statusTramitacao', 'prazoSlaEm', 'slaStatus', 'criadoPor', 'criadoPorId', 'dataCriacao', 'prazoDias', 'prazoRegularizacaoDias', 'prazoRegularizacaoEm', 'statusRegularizacao', 'dataCienciaAuto', 'prazoDefesaDias', 'prazoDefesaEm', 'statusDefesa', 'baseLegalPrazo']);
      allow delete: if admin() && sameSector(resource.data);

      match /evidencias/{evidenceId} {
        allow read: if approved() && sameSector(get(/databases/$(database)/documents/notificacoes/$(documentId)).data);
        allow create: if approved() && profile().data.nivel != 'leitor'
          && sameSector(get(/databases/$(database)/documents/notificacoes/$(documentId)).data)
          && request.resource.data.setor == sector()
          && request.resource.data.storagePath is string
          && !('imagemBinaria' in request.resource.data);
        allow update: if false;
        allow delete: if admin() && sameSector(get(/databases/$(database)/documents/notificacoes/$(documentId)).data);
      }
    }

    match /infracoes_config/{documentId} {
      allow read: if approved() && (resource.data.setor == sector() || !('setor' in resource.data));
      allow create: if admin() && request.resource.data.setor == sector();
      allow update, delete: if admin() && sameSector(resource.data);
    }

    match /logs_auditoria/{documentId} {
      allow read: if admin() && sameSector(resource.data);
      // Eventos imutáveis são gravados somente por backend confiável.
      allow create: if false;
      allow update, delete: if false;
    }

    match /cadastro_imobiliario/{documentId} {
      allow read: if approved() && (profile().data.nivel == 'operador' || profile().data.nivel == 'admin');
      allow create, update, delete: if false;
    }

    match /configuracoes/sistema {
      allow read: if approved();
      allow write: if admin();
    }

    match /configuracoes/{documentId} {
      allow read: if admin() || (approved() && documentId == "parametros_" + sector());
      allow create, update, delete: if admin() && documentId != "parametros_" + sector();
    }

    match /iptu_import_jobs/{jobId} {
      allow read: if admin() && sameSector(resource.data);
      allow create: if admin() && request.resource.data.setor == sector() && request.resource.data.status == 'pendente';
      allow update, delete: if false;
    }

    match /sequencias/{sequenceId} {
      allow read, write: if false;
    }
  }
}
