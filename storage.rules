rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)); }
    function admin() { return signedIn() && profile().data.status == 'aprovado' && profile().data.nivel == 'admin'; }

    match /iptu_backup/{fileName} {
      allow read, write: if admin() && fileName == 'base_anterior.json';
    }
  }
}
